<view class="page">
  <view class="page-glow"></view>
  <view class="page-inner">

    <!-- 头部 -->
    <view class="room-hero" wx:if="{{pair}}">
      <view class="hero-kicker">和{{pair.partner.name}}交换的日子</view>
      <view class="hero-title" wx:if="{{pair.dates.length > 1}}">你们在 {{pair.dates.length}} 个日子里<view class="br"></view>同时按下了快门</view>
      <view class="hero-title" wx:else>你们在同一天<view class="br"></view>按下了快门</view>
      <view class="hero-meta mono" wx:if="{{spanLabel}}">{{spanLabel}}</view>
    </view>

    <!-- 每一天：左右对照 -->
    <view class="day" wx:for="{{groups}}" wx:key="date">
      <view class="day-head">
        <view class="day-date">{{item.pretty}}</view>
        <view class="day-week">{{item.week}}</view>
      </view>

      <view class="cols">
        <!-- 你 -->
        <view class="col">
          <view class="lane-tag me">你</view>
          <view class="shots" wx:if="{{item.mine.length}}">
            <view
              class="shot"
              wx:for="{{item.mine}}"
              wx:for-item="p"
              wx:key="id"
              bindtap="openShot"
              data-id="{{p.id}}"
              data-side="mine"
            >
              <image wx:if="{{!p.svg}}" class="shot-img" src="{{p.thumb}}" mode="aspectFill" />
              <view wx:else class="shot-img sky-ph g{{p.grad}}">
                <view class="sky-sun" style="left:{{p.sunX}}%;top:{{p.sunY}}%"></view>
              </view>
              <view class="shot-time mono" wx:if="{{p.time}}">{{p.time}}</view>
              <view class="shot-live" wx:if="{{p.motion}}">动态</view>
              <view class="shot-live ghost" wx:elif="{{p.live}}">实况</view>
            </view>
          </view>
          <view class="locked quiet" wx:else>
            <view class="locked-text"><view class="locked-title">这一天没有照片</view></view>
          </view>
        </view>

        <!-- 对方 -->
        <view class="col">
          <view class="lane-tag them">{{pair.partner.name}}</view>
          <view class="shots" wx:if="{{item.canSee}}">
            <view
              class="shot"
              wx:for="{{item.theirs}}"
              wx:for-item="p"
              wx:key="id"
              bindtap="openShot"
              data-id="{{p.id}}"
              data-side="theirs"
            >
              <image wx:if="{{!p.svg}}" class="shot-img" src="{{p.thumb}}" mode="aspectFill" />
              <view wx:else class="shot-img sky-ph g{{p.grad}}">
                <view class="sky-sun" style="left:{{p.sunX}}%;top:{{p.sunY}}%"></view>
              </view>
              <view class="shot-time mono" wx:if="{{p.time}}">{{p.time}}</view>
              <view class="shot-live" wx:if="{{p.motion}}">动态</view>
              <view class="shot-live ghost" wx:elif="{{p.live}}">实况</view>
            </view>
          </view>
          <view class="locked" wx:else>
            <view class="locked-text">
              <view class="locked-title">{{pair.mine ? '等 TA 展示' : '等你先展示'}}</view>
              <view class="locked-sub">双方都按下展示后，这一天才会同时亮起来</view>
            </view>
          </view>
        </view>
      </view>
    </view>

  </view>
</view>

<!-- 底部操作 -->
<view class="dock" wx:if="{{pair && !pair.mine}}">
  <button class="btn primary block" bindtap="reveal" loading="{{revealing}}" disabled="{{revealing}}">
    展示我的这一天
  </button>
  <view class="tiny dock-tip">按下去，TA 就能看到你那天拍下的样子。</view>
</view>

<view class="dock whisper" wx:if="{{pair && pair.mine && !pair.canSee}}">
  <view class="muted">你已经按下了展示，等 TA 也打开这一页。</view>
</view>

<view class="dock whisper" wx:if="{{pair && pair.canSee}}">
  <view class="muted">你们彼此都看见了。</view>
</view>

<!-- 单张预览：动态直接播，静态可缩放 -->
<view class="viewer" wx:if="{{viewing}}" bindtap="closeShot">
  <view class="viewer-stage" catchtap="noop">
    <video
      wx:if="{{viewing.hasMotion}}"
      class="viewer-media"
      src="{{viewing.motion}}"
      object-fit="contain"
      autoplay
      loop
      muted
      controls="{{false}}"
      show-center-play-btn="{{false}}"
      show-fullscreen-btn="{{false}}"
      show-play-btn="{{false}}"
    />
    <image
      wx:elif="{{!viewing.svg}}"
      class="viewer-media"
      src="{{viewing.thumb}}"
      mode="aspectFit"
      bindtap="previewStill"
    />
    <view wx:else class="viewer-sky sky-ph g{{viewing.grad}}">
      <view class="sky-sun" style="left:{{viewing.sunX}}%;top:{{viewing.sunY}}%"></view>
    </view>
  </view>
  <view class="viewer-cap mono">{{viewing.time || '时间未知'}} · {{viewing.datePretty}}</view>
  <view class="viewer-note" wx:if="{{viewing.hasMotion}}">动态照片 · 画面在轻轻流动</view>
  <view class="viewer-note" wx:elif="{{viewing.live}}">实况的封面 · 动态部分微信没开放给小程序</view>
  <view class="viewer-note dim">点空白处关闭</view>
</view>
