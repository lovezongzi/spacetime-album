/* ------------------------------ 头部 ------------------------------ */

.room-hero {
  margin-top: 28rpx;
  padding: 44rpx 36rpx 40rpx;
  border-radius: 40rpx;
  background: linear-gradient(158deg, #2a2440 0%, #4d3355 44%, #a95c53 76%, #e8945f 100%);
  color: #fff;
  position: relative;
  overflow: hidden;
  box-shadow: 0 18rpx 48rpx rgba(58, 34, 54, 0.24);
}

.room-hero::after {
  content: "";
  position: absolute;
  right: -70rpx;
  top: -110rpx;
  width: 340rpx;
  height: 340rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 226, 180, 0.28) 0%, rgba(255, 226, 180, 0) 66%);
}

.hero-kicker {
  font-size: 23rpx;
  letter-spacing: 2rpx;
  color: rgba(255, 235, 220, 0.66);
}

.hero-title {
  margin-top: 16rpx;
  font-size: 40rpx;
  font-weight: 650;
  line-height: 1.42;
  letter-spacing: -0.5rpx;
}

.hero-meta {
  margin-top: 20rpx;
  font-size: 23rpx;
  color: rgba(255, 235, 220, 0.62);
  letter-spacing: 0.6rpx;
}

.br {
  height: 0;
}

/* ------------------------------ 每一天 ------------------------------ */

.day {
  margin-top: 26rpx;
  background: #ffffff;
  border-radius: 36rpx;
  padding: 30rpx 26rpx 30rpx;
  box-shadow: 0 2rpx 6rpx rgba(29, 26, 23, 0.04), 0 12rpx 34rpx rgba(29, 26, 23, 0.05);
}

.day-head {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  padding: 0 4rpx 4rpx;
}

.day-date {
  font-size: 31rpx;
  font-weight: 650;
  letter-spacing: -0.3rpx;
}

.day-week {
  font-size: 23rpx;
  color: #a89e93;
}

/* ------------------------------ 左右对照 ------------------------------ */

.cols {
  display: flex;
  gap: 18rpx;
  margin-top: 18rpx;
  align-items: flex-start;
}

.col {
  flex: 1;
  min-width: 0;
}

.lane-tag {
  display: inline-block;
  font-size: 21rpx;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  letter-spacing: 0.4rpx;
  margin-bottom: 12rpx;
}

.lane-tag.me {
  background: rgba(29, 26, 23, 0.06);
  color: #6d645a;
}

.lane-tag.them {
  background: linear-gradient(120deg, #fff1e6, #ffe6c9);
  color: #a3441c;
  font-weight: 600;
}

.shots {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.shot {
  position: relative;
  width: 100%;
  padding-top: 100%;
  border-radius: 20rpx;
  overflow: hidden;
  background: #ece5db;
}

.shot-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.shot-time {
  position: absolute;
  left: 8rpx;
  bottom: 8rpx;
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
  background: rgba(22, 18, 15, 0.46);
  color: rgba(255, 255, 255, 0.94);
  font-size: 19rpx;
  z-index: 2;
}

/* ------------------------------ 未展示 ------------------------------ */

.locked {
  position: relative;
  width: 100%;
  padding-top: 100%;
  border-radius: 20rpx;
  overflow: hidden;
  background: linear-gradient(125deg, #efe7dc 0%, #e5d9cc 46%, #f3ece3 100%);
}

.locked.quiet {
  background: #faf7f2;
}

.locked::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: repeating-linear-gradient(118deg, rgba(255, 255, 255, 0.42) 0 20rpx, rgba(255, 255, 255, 0) 20rpx 40rpx);
  opacity: 0.55;
}

.locked-text {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  text-align: center;
}

.locked-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #6d645a;
  line-height: 1.4;
}

.locked-sub {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #a89e93;
  line-height: 1.45;
}

.locked.quiet .locked-title {
  color: #b3a99e;
  font-weight: 400;
}

/* ------------------------------ 底部 ------------------------------ */

.dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 24rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(245, 241, 234, 0) 0%, #f5f1ea 26%, #f5f1ea 100%);
}

.page {
  padding-bottom: 220rpx;
}

.dock-tip {
  margin-top: 16rpx;
  text-align: center;
}

.dock.whisper {
  padding-top: 28rpx;
  padding-bottom: calc(36rpx + env(safe-area-inset-bottom));
  text-align: center;
}
