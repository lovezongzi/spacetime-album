/* ------------------------------ 分段控件 ------------------------------ */

.seg {
  margin-top: 28rpx;
  display: flex;
  padding: 6rpx;
  background: rgba(29, 26, 23, 0.05);
  border-radius: 34rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 26rpx;
  color: #7d746a;
  border-radius: 28rpx;
  letter-spacing: 0.4rpx;
  transition: all 0.18s ease;
}

.seg-item.on {
  background: #ffffff;
  color: #1d1a17;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(29, 26, 23, 0.09);
}

/* ------------------------------ 抽到的一天 ------------------------------ */

.lucky {
  margin-top: 32rpx;
  border-radius: 40rpx;
  padding: 56rpx 40rpx 44rpx;
  background: linear-gradient(160deg, #2a2440 0%, #4d3355 46%, #a95c53 78%, #e8945f 100%);
  color: #fff;
  position: relative;
  overflow: hidden;
  box-shadow: 0 18rpx 48rpx rgba(58, 34, 54, 0.26);
}

.lucky::after {
  content: "";
  position: absolute;
  right: -80rpx;
  top: -120rpx;
  width: 380rpx;
  height: 380rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 226, 180, 0.3) 0%, rgba(255, 226, 180, 0) 66%);
}

.lucky-label {
  font-size: 23rpx;
  letter-spacing: 3rpx;
  color: rgba(255, 235, 220, 0.62);
}

.lucky-date {
  margin-top: 18rpx;
  font-size: 84rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
  line-height: 1.1;
  text-shadow: 0 6rpx 30rpx rgba(0, 0, 0, 0.24);
}

.lucky-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 235, 220, 0.66);
  letter-spacing: 1rpx;
}

.lucky-note {
  margin-top: 30rpx;
  font-size: 27rpx;
  color: rgba(255, 245, 235, 0.8);
  line-height: 1.6;
}

.lucky-note.strong {
  color: #fff8ee;
  font-weight: 600;
  font-size: 29rpx;
}

.lucky-actions {
  margin-top: 34rpx;
  display: flex;
}

.redraw {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 40rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 2rpx solid rgba(255, 255, 255, 0.26);
  color: #fff;
  font-size: 26rpx;
  font-weight: 500;
  backdrop-filter: blur(10rpx);
}

/* ------------------------------ 时间段 ------------------------------ */

.range-box {
  margin-top: 32rpx;
  background: #ffffff;
  border-radius: 36rpx;
  padding: 36rpx 32rpx 32rpx;
  box-shadow: 0 2rpx 6rpx rgba(29, 26, 23, 0.04), 0 12rpx 36rpx rgba(29, 26, 23, 0.05);
}

.range-row {
  display: flex;
  align-items: center;
}

.range-row picker {
  flex: 1;
}

.range-pick {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #fbf6ef;
  border-radius: 24rpx;
  font-size: 27rpx;
  color: #1d1a17;
  font-variant-numeric: tabular-nums;
}

.range-pick.ph {
  color: #b6ada2;
}

.range-dash {
  padding: 0 18rpx;
  color: #c3b9ad;
}

.range-hint {
  margin-top: 16rpx;
  text-align: center;
}

.range-go {
  margin-top: 28rpx;
}

/* ------------------------------ 候选人 ------------------------------ */

.cand {
  display: flex;
  align-items: center;
  gap: 22rpx;
  background: #ffffff;
  border-radius: 30rpx;
  padding: 26rpx 26rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 6rpx rgba(29, 26, 23, 0.04), 0 10rpx 30rpx rgba(29, 26, 23, 0.045);
}

.cand .av {
  width: 84rpx;
  height: 84rpx;
  font-size: 34rpx;
}

.cand-name {
  font-size: 29rpx;
  font-weight: 600;
  letter-spacing: -0.3rpx;
}

.cand-meta {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #9b9287;
  line-height: 1.5;
}

.swap-btn {
  flex-shrink: 0;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 34rpx;
  border-radius: 32rpx;
  background: linear-gradient(120deg, #ff6b45 0%, #ff9e58 60%, #ffc978 100%);
  color: #3a1a08;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 69, 0.26);
}

/* ------------------------------ 弹层 ------------------------------ */

.sheet-head {
  margin-bottom: 18rpx;
}

.sheet-tip {
  line-height: 1.6;
  margin-bottom: 22rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
}

.sheet-go {
  margin-top: 24rpx;
}

/* ------------------------------ 空态 ------------------------------ */

.empty-box {
  margin-top: 40rpx;
  padding: 80rpx 44rpx 60rpx;
  background: #ffffff;
  border-radius: 36rpx;
  text-align: center;
  box-shadow: 0 2rpx 6rpx rgba(29, 26, 23, 0.04), 0 12rpx 36rpx rgba(29, 26, 23, 0.05);
}

.empty-emoji {
  font-size: 60rpx;
  color: #ff9e58;
  opacity: 0.45;
  margin-bottom: 16rpx;
}

.empty-desc {
  margin-top: 14rpx;
  line-height: 1.7;
}

.go-album {
  margin-top: 32rpx;
  display: inline-flex;
}

.br {
  height: 0;
}
