/* 时空相册 —— 全局样式（移动端优先，750rpx 基准） */

page {
  background: #f5f1ea;
  color: #1d1a17;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB",
    "Noto Sans SC", sans-serif;
  -webkit-font-smoothing: antialiased;
  font-size: 28rpx;
  line-height: 1.55;
}

view,
text,
input,
button,
scroll-view {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 0 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.page-glow {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  height: 640rpx;
  background: radial-gradient(520rpx 320rpx at 50% 0%, #fff6ea 0%, rgba(255, 246, 234, 0) 70%),
    radial-gradient(420rpx 300rpx at 92% 30%, #f6e8f2 0%, rgba(246, 232, 242, 0) 72%);
  pointer-events: none;
  z-index: 0;
}

.page-inner {
  position: relative;
  z-index: 1;
}

/* ------------------------------- 排版 ------------------------------- */

.h1 {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.25;
}

.h2 {
  font-size: 36rpx;
  font-weight: 650;
  letter-spacing: -0.5rpx;
  line-height: 1.35;
}

.h3 {
  font-size: 30rpx;
  font-weight: 600;
}

.body {
  font-size: 28rpx;
  color: #4a443d;
}

.muted {
  font-size: 26rpx;
  color: #9b9287;
}

.tiny {
  font-size: 23rpx;
  color: #a89e93;
}

.mono {
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}

.section {
  margin-top: 44rpx;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

/* ------------------------------- 卡片 ------------------------------- */

.card {
  background: #ffffff;
  border-radius: 36rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 6rpx rgba(29, 26, 23, 0.04), 0 12rpx 36rpx rgba(29, 26, 23, 0.05);
}

.card-flat {
  background: #fbf8f3;
  border-radius: 28rpx;
  padding: 28rpx;
}

/* ------------------------------- 按钮 ------------------------------- */

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  border: none;
  padding: 0 40rpx;
  margin: 0;
  line-height: 1;
}

.btn::after {
  border: none;
}

.btn.primary {
  background: linear-gradient(120deg, #ff6b45 0%, #ff9e58 48%, #ffc978 100%);
  color: #3a1a08;
  box-shadow: 0 10rpx 28rpx rgba(255, 107, 69, 0.28);
}

.btn.ghost {
  background: #ffffff;
  color: #1d1a17;
  box-shadow: 0 2rpx 6rpx rgba(29, 26, 23, 0.05), 0 10rpx 26rpx rgba(29, 26, 23, 0.06);
}

.btn.quiet {
  background: transparent;
  color: #9b9287;
  font-weight: 500;
}

.btn.block {
  width: 100%;
}

.btn.small {
  height: 68rpx;
  font-size: 26rpx;
  border-radius: 34rpx;
  padding: 0 32rpx;
}

.btn[disabled] {
  opacity: 0.5;
}

/* ------------------------------- 头像 ------------------------------- */

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #ffffff;
  font-weight: 600;
  flex-shrink: 0;
}

.g0 { background: linear-gradient(140deg, #ff6b45, #ffc978); }
.g1 { background: linear-gradient(140deg, #2a2440, #6b4a72); }
.g2 { background: linear-gradient(140deg, #223a5e, #a8d5e5); }
.g3 { background: linear-gradient(140deg, #8a4b3c, #e1844b); }
.g4 { background: linear-gradient(140deg, #4a6741, #a8c090); }
.g5 { background: linear-gradient(140deg, #5b3a5e, #c4736f); }

/* ------------------------------- 布局 ------------------------------- */

.row {
  display: flex;
  align-items: center;
}

.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.grow {
  flex: 1;
  min-width: 0;
}

.gap-12 { gap: 12rpx; }
.gap-20 { gap: 20rpx; }
.gap-28 { gap: 28rpx; }

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ------------------------------- 占位 ------------------------------- */

.empty {
  padding: 72rpx 40rpx;
  text-align: center;
}

.empty-emoji {
  font-size: 60rpx;
  opacity: 0.35;
  margin-bottom: 20rpx;
}

.sky-ph {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

/* 底部压一层暗角，让渐变读起来像天空压着地平线 */
.sky-ph::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 36%;
  background: linear-gradient(180deg, rgba(20, 14, 24, 0) 0%, rgba(20, 14, 24, 0.32) 100%);
  pointer-events: none;
}

.sky-sun {
  position: absolute;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.84);
  box-shadow: 0 0 48rpx 22rpx rgba(255, 255, 255, 0.2);
  z-index: 1;
}

/* ------------------------------- 遮罩弹层 ------------------------------- */

.mask {
  position: fixed;
  inset: 0;
  background: rgba(20, 16, 13, 0.42);
  z-index: 90;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 91;
  background: #fbf8f3;
  border-radius: 44rpx 44rpx 0 0;
  padding: 32rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  max-height: 82vh;
  display: flex;
  flex-direction: column;
}

.sheet-grip {
  width: 76rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(29, 26, 23, 0.14);
  margin: 0 auto 28rpx;
}

.sheet-body {
  flex: 1;
  overflow-y: auto;
}

/* ------------------------------- 日期块 ------------------------------- */

.day-chip {
  display: inline-flex;
  align-items: center;
  height: 62rpx;
  padding: 0 26rpx;
  border-radius: 31rpx;
  background: #ffffff;
  color: #4a443d;
  font-size: 25rpx;
  margin: 0 14rpx 14rpx 0;
  border: 2rpx solid transparent;
}

.day-chip.on {
  background: linear-gradient(120deg, #fff1e6, #ffe6c9);
  color: #a3441c;
  border-color: rgba(255, 140, 88, 0.5);
  font-weight: 600;
}
